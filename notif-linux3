#!/bin/bash

# ==========================================
# PARAMETER DEFAULT (Gampang diatur di sini)
# ==========================================
DIR_UPDATE="/home/user2/Update"
NOTIF_TIME_WARNING=15000  # Durasi notif peringatan (ms)
NOTIF_TIME_SUCCESS=10000   # Durasi notif sukses (ms)
JEDA_NOTIF=2              # Jeda waktu dalam detik antar notifikasi

# Parameter default teks petunjuk/pesan tambahan
PESAN_DEFAULT_2="Silahkan buka apk Termux di android dan pilih buku update no.2"

# Status penanda apakah ada update yang hilang/belum ada
ADA_YANG_KOSONG=0

# ==========================================
# PENGECEKAN FILE SATU PERSATU
# (Kamu bisa tambah ke bawah dengan pola sama)
# ==========================================

# Cek Update 1 (Sound)
FILE1="$DIR_UPDATE/Update6.txt"
if [ ! -f "$FILE1" ]; then
    notify-send -t "$NOTIF_TIME_WARNING" "⚠️ Update ditemukan!" "Ada update untuk open file dari android dan perbaikan shutdown"
    sleep "$JEDA_NOTIF"
    notify-send -t "$NOTIF_TIME_WARNING" "ℹ️ Petunjuk Update" "$PESAN_DEFAULT_2"
    ADA_YANG_KOSONG=1
fi

# Cek Update 2 (Visual)
FILE2="$DIR_UPDATE/Update4.txt"
if [ ! -f "$FILE2" ]; then
    notify-send -t "$NOTIF_TIME_WARNING" "⚠️ Update 1 ditemukan" "Perbaikan fungsi shutdown dan masuk lagi tidak bisa"
    sleep "$JEDA_NOTIF"
    notify-send -t "$NOTIF_TIME_WARNING" "ℹ️ Petunjuk Update" "$PESAN_DEFAULT_2"
    ADA_YANG_KOSONG=1
fi

# --- CONTOH KALAU NANTI MAU NGECEK LAGI (tinggal uncomment/tambah sendiri) ---
