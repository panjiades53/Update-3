# fi
# --------------------------------------------------------------------------

# ==========================================
# KONDISI AKHIR
# ==========================================
# Jika semua file di atas ternyata ADA (tidak ada yang kosong), munculkan sukses
if [ "$ADA_YANG_KOSONG" -eq 0 ]; then
    notify-send -t "$NOTIF_TIME_SUCCESS" "System Update ✅"
fi
